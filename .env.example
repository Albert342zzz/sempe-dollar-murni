# Copy this file to `.env` and fill in the real values.
# Do NOT commit `.env` (already git-ignored).

# --- Database (Supabase / PostgreSQL) ---
# Pooled connection (port 6543) — used by the app at runtime.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true"
# Direct connection (port 5432) — used for migrations (prisma migrate).
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# --- Admin/session authentication ---
# Long random string used to sign the admin session cookie (e.g. `openssl rand -hex 32`).
# Admin access is granted via Google login + the ADMIN role (managed in /admin/users),
# so there are no hardcoded admin credentials.
AUTH_SECRET="replace-with-a-long-random-string"

# --- Supabase Auth (login via Google) ---
# From the Supabase dashboard: Settings -> Data API (Project URL) & API Keys (anon public).
NEXT_PUBLIC_SUPABASE_URL="https://xxxx.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="anon-public-key"

# --- "Mbak Sempe" AI assistant (chat widget) + sales report insight ---
# Free API key from Google AI Studio: https://aistudio.google.com/apikey
# Used by /api/chat (Gemini) and the admin sales report summary.
GEMINI_API_KEY="AIza..."
# Optional: set "false" to disable AI narrative for reports (uses template instead).
# USE_AI_INSIGHT="true"
