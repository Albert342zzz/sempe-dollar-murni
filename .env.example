# Copy this file to `.env` and fill in the real values.
# Do NOT commit `.env` (already git-ignored).

# --- Database (Supabase / PostgreSQL) ---
# Pooled connection (port 6543) — used by the app at runtime.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true"
# Direct connection (port 5432) — used for migrations (prisma migrate).
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# --- Admin authentication ---
# Long random string used to sign sessions (e.g. `openssl rand -hex 32`).
AUTH_SECRET="replace-with-a-long-random-string"
# Admin login credentials.
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="replace-with-a-strong-password"

# --- Supabase Auth (customer login via Google) ---
# From the Supabase dashboard: Settings -> Data API (Project URL) & API Keys (anon public).
NEXT_PUBLIC_SUPABASE_URL="https://xxxx.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="anon-public-key"
