# Salin file ini menjadi `.env` lalu isi dengan nilai asli.
# JANGAN commit file `.env` (sudah diabaikan git).

# --- Database (Supabase / PostgreSQL) ---
# Pooled connection (port 6543) — dipakai aplikasi saat runtime.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true"
# Direct connection (port 5432) — dipakai untuk migrasi (prisma migrate).
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# --- Autentikasi admin ---
# String acak panjang untuk menandatangani sesi (mis. `openssl rand -hex 32`).
AUTH_SECRET="ganti-dengan-string-acak-panjang"
# Kredensial login admin.
ADMIN_EMAIL="admin@contoh.com"
ADMIN_PASSWORD="ganti-dengan-password-kuat"
