// Skema database Sempe Dollar Murni
// Dokumentasi: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Rasa Sempe (id memakai slug, mis. "original", "keju")
model Flavor {
  id          String        @id
  name        String
  description String
  accent      String
  image       String
  createdAt   DateTime      @default(now())
  orderItems  OrderItem[]
  prices      FlavorPrice[]
}

// Ukuran kemasan. `price` dipakai sebagai harga default/awal saat
// membuat harga per rasa. Harga sebenarnya ada di FlavorPrice.
model Size {
  id     Int           @id @default(autoincrement())
  label  String        @unique // "250gr", "500gr", "1kg"
  price  Int
  prices FlavorPrice[]
}

// Harga per kombinasi rasa + ukuran (dalam Rupiah).
model FlavorPrice {
  id       Int    @id @default(autoincrement())
  flavor   Flavor @relation(fields: [flavorId], references: [id], onDelete: Cascade)
  flavorId String
  size     Size   @relation(fields: [sizeId], references: [id], onDelete: Cascade)
  sizeId   Int
  price    Int

  @@unique([flavorId, sizeId])
}

model Order {
  id           Int         @id @default(autoincrement())
  customerName String
  phone        String
  userId       String? // ID akun Supabase pemesan (null untuk tamu)
  status       OrderStatus @default(BARU)
  total        Int // total harga (Rupiah)
  createdAt    DateTime    @default(now())
  items        OrderItem[]

  @@index([userId])
}

model OrderItem {
  id        Int    @id @default(autoincrement())
  order     Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId   Int
  flavor    Flavor @relation(fields: [flavorId], references: [id])
  flavorId  String
  sizeLabel String
  qty       Int
  price     Int // harga satuan saat pemesanan (Rupiah)
}

enum OrderStatus {
  BARU
  DIPROSES
  SELESAI
}

enum UserRole {
  USER
  ADMIN
}

model UserProfile {
  id        Int      @id @default(autoincrement())
  userId    String   @unique
  email     String
  nickname  String
  phone     String
  role      UserRole @default(USER)
  createdAt DateTime @default(now())
}
