// Skema database Sempe Dollar Murni
// Dokumentasi: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Rasa Sempe (id memakai slug, mis. "original", "keju")
model Flavor {
  id          String        @id
  name        String
  description String
  accent      String
  image       String
  createdAt   DateTime      @default(now())
  orderItems  OrderItem[]
  prices      FlavorPrice[]
}

// Ukuran kemasan. `price` dipakai sebagai harga default/awal saat
// membuat harga per rasa. Harga sebenarnya ada di FlavorPrice.
model Size {
  id     Int           @id @default(autoincrement())
  label  String        @unique // "250gr", "500gr", "1kg"
  price  Int
  prices FlavorPrice[]
}

// Harga per kombinasi rasa + ukuran (dalam Rupiah).
model FlavorPrice {
  id       Int    @id @default(autoincrement())
  flavor   Flavor @relation(fields: [flavorId], references: [id], onDelete: Cascade)
  flavorId String
  size     Size   @relation(fields: [sizeId], references: [id], onDelete: Cascade)
  sizeId   Int
  price    Int

  @@unique([flavorId, sizeId])
}

model Order {
  id           Int         @id @default(autoincrement())
  customerName String
  phone        String
  userId       String? // ID akun Supabase pemesan (null untuk tamu)
  status       OrderStatus @default(BARU)
  total        Int // total harga (Rupiah)
  createdAt    DateTime    @default(now())
  items        OrderItem[]

  @@index([userId])
}

model OrderItem {
  id        Int    @id @default(autoincrement())
  order     Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId   Int
  flavor    Flavor @relation(fields: [flavorId], references: [id])
  flavorId  String
  sizeLabel String
  qty       Int
  price     Int // harga satuan saat pemesanan (Rupiah)
}

enum OrderStatus {
  BARU
  DIPROSES
  SELESAI
  DIBATALKAN
}

enum UserRole {
  USER
  ADMIN
}

model UserProfile {
  id        Int      @id @default(autoincrement())
  userId    String   @unique
  email     String
  nickname  String
  phone     String
  role      UserRole @default(USER)
  createdAt DateTime @default(now())
}

// Pre-authorized email added by an admin, for people who haven't signed up yet.
// On their first Google login the invite is consumed: the profile is created
// with this role and the row is deleted.
model UserInvite {
  id        Int      @id @default(autoincrement())
  email     String   @unique // always stored lowercase
  role      UserRole @default(ADMIN)
  createdAt DateTime @default(now())
}

// Sales report for one period (month/year), uploaded as Excel by admin.
// Figures are calculated deterministically by code (not AI); aiSummary is narrative only.
model SalesReport {
  id             Int           @id @default(autoincrement())
  filename       String
  uploadedAt     DateTime      @default(now())
  periodMonth    Int // 1-12, selected by admin on upload
  periodYear     Int
  totalAmount    Int // total sales (IDR)
  totalQty       Int
  validRows      Int // successfully parsed sales rows
  skippedRows    Int // skipped rows (TOTAL/summary or incomplete)
  skippedRowNums Int[] // Excel row numbers that were skipped
  aiSummary      String? // narrative summary (Gemini or template fallback)
  records        SalesRecord[]

  @@index([periodYear, periodMonth])
}

// One sales row: flavor + size + quantity.
model SalesRecord {
  id        Int         @id @default(autoincrement())
  report    SalesReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  reportId  Int
  flavor    String // flavor label (e.g. "Keju") or raw code if unrecognized
  size      String // size label (e.g. "350gr")
  qty       Int
  unitPrice Int
  amount    Int

  @@index([reportId])
}

// Admin-managed gallery photos. Image bytes are stored directly in the DB
// (Bytes) and served via /api/gallery/[id].
model GalleryImage {
  id        Int      @id @default(autoincrement())
  data      Bytes
  mimeType  String
  alt       String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sortOrder])
}

// Stores/outlets that sell the product ("Where to find our products"). Admin-managed.
model Outlet {
  id        Int      @id @default(autoincrement())
  name      String
  address   String
  createdAt DateTime @default(now())
}

// Frequently asked questions shown as an accordion on the Contact page.
// Admin-managed; the section hides when there are none. `sortOrder` lets the
// admin control the order (lower first), falling back to id.
model Faq {
  id        Int      @id @default(autoincrement())
  question  String
  answer    String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@index([sortOrder])
}

// Lightweight first-party analytics events (e.g. WhatsApp clicks, product
// views). `type` categorizes the event; `meta` holds flexible per-event data
// (source, flavor, etc.) so new event kinds can be added without a schema change.
model SiteEvent {
  id        Int      @id @default(autoincrement())
  type      String
  path      String?
  meta      Json?
  createdAt DateTime @default(now())

  @@index([type, createdAt])
}
